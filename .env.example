# Neon: hämta med `neon env pull` (skriver .env) eller kopiera från Neon Console → Connect.
# Lägg in DATABASE_URL i Netlify: Site configuration → Environment variables.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Sätt till true för att köra utan databas med lokal exempeldata
# VITE_DEMO_DATA=true
